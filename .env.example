# 공공데이터포털(data.go.kr) 일반 인증키.
# Encoding / Decoding 두 가지가 발급되는데 Decoding 키를 넣는다.
# httpx가 params를 자동 인코딩하므로 Encoding 키를 넣으면 이중 인코딩으로 인증 실패한다.
# 어느 쪽이 맞는지는 scripts/smoke.py 로 확정한다.
NOWBUS_SEOUL_API_KEY=

# 앱 접근 토큰 (X-Token 헤더). 아무 긴 문자열이나.
NOWBUS_API_TOKEN=change-me

# SQLite 경로
NOWBUS_DB_PATH=data/nowbus.db
